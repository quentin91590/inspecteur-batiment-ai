# Copier en functions/.env pour activer un fournisseur compatible OpenAI (Qwen, Infomaniak, Mistral, OpenRouter…)
# Les clés, elles, vont dans Secret Manager : firebase functions:secrets:set OPENAI_COMPAT_API_KEY
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_MODELS=
# Exemple Qwen (Alibaba Cloud, serveurs Singapour) :
# OPENAI_COMPAT_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# OPENAI_COMPAT_MODELS=qwen3.8-omni-flash|Qwen 3.8 Omni Flash
ENFORCE_APP_CHECK=false
AI_MIN_INSTANCES=0
